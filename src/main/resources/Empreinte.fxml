<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.EmpreinteController">
    <children>
        <!-- Left panel -->
        <AnchorPane prefWidth="392.0" style="-fx-background-color: #6200ea;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fitHeight="261.0" fitWidth="259.0" layoutX="61.0" layoutY="83.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/images/logo.png" />
                    </image>
                </ImageView>
                <Label layoutX="62.0" layoutY="313.0" prefWidth="268.0" text="Gestion de la Ville Intelligente" textFill="WHITE">
                    <font>
                        <Font name="Roboto" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="89.0" layoutY="343.0" prefWidth="213.0" text="Gérez efficacement les services urbains" textFill="WHITE">
                    <font>
                        <Font name="Roboto" size="12.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <!-- Right panel -->
        <AnchorPane style="-fx-background-color: #ffffff;" AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Button fx:id="btnRegisterFingerprint" layoutX="78.0" layoutY="80.0" prefHeight="50.0" prefWidth="300.0"
                        style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold;"
                        text="Enregistrer votre empreinte faciale"
                        onAction="#Enregistre_Visage"/>

                <Button fx:id="btnPasse" layoutX="78.0" layoutY="160.0" prefHeight="50.0" prefWidth="300.0"
                        style="-fx-background-color: #03dac5; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold;"
                        text="Passer"
                        onAction="#Passe"/>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>