<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MessageController">
    <children>
        <VBox alignment="CENTER" prefHeight="490.0" prefWidth="911.0" spacing="5">
            <padding>
                <Insets bottom="6" left="6" right="6" top="6" />
            </padding>
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Messages" />

                <HBox alignment="CENTER" spacing="5">
                    <children>
                        <Button onAction="#handleRetour" style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 15px; -fx-font-weight: bold;" text="Retour" />

                        <ComboBox fx:id="receiverComboBox" prefWidth="200" promptText="Receiver" style="-fx-background-color: #f0f0f5; -fx-border-radius: 15px; -fx-border-color: #ccc; -fx-padding: 3px;" />
                        <TextField fx:id="messageField" prefWidth="200" promptText="Message" style="-fx-background-color: #f0f0f5; -fx-border-radius: 15px; -fx-border-color: #ccc; -fx-padding: 3px;" />
                        <Button onAction="#handleSendMessage" style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 15px; -fx-font-weight: bold;" text="Send" />
                    </children>
                </HBox>

                <TextArea fx:id="messageTextArea" prefWidth="400" prefHeight="300" />
            </children>
        </VBox>
    </children>
</AnchorPane>