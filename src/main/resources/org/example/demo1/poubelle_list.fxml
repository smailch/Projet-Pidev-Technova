<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo1.controllers.PoubelleListController" spacing="10">
    <TableView fx:id="poubelleTable">
        <columns>
            <TableColumn text="ID" prefWidth="50">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Type de Déchets" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="type_dechets" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Niveau de Remplissage" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="niveau_remplissage" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Localisation" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="localisation" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Zone ID" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="zoneId" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    <Button text="Refresh" onAction="#refreshTable" />
    <Button fx:id="deleteButton" text="Delete" onAction="#handleDeleteButton" />
    <Button fx:id="updateButton" text="Update" onAction="#handleUpdateButton" />
</VBox>