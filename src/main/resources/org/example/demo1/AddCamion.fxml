<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo1.controllers.AddCamionController"
            prefWidth="400" prefHeight="300">
    <children>
        <!-- Title Label -->
        <Label text="Add Camion" layoutX="150" layoutY="20" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <!-- Capacite Max Field -->
        <Label text="Capacité Max:" layoutX="50" layoutY="70" />
        <TextField fx:id="capaciteMaxField" layoutX="150" layoutY="65" prefWidth="200" />

        <!-- Statut ComboBox -->
        <Label text="Statut:" layoutX="50" layoutY="110" />
        <ComboBox fx:id="statutComboBox" layoutX="150" layoutY="105" prefWidth="200" />

        <!-- Zone ComboBox -->
        <Label text="Zone:" layoutX="50" layoutY="150" />
        <ComboBox fx:id="zoneComboBox" layoutX="150" layoutY="145" prefWidth="200" />

        <!-- Add Button -->
        <Button text="Add Camion" layoutX="150" layoutY="200" prefWidth="100" onAction="#handleAddCamion" />
    </children>
</AnchorPane>