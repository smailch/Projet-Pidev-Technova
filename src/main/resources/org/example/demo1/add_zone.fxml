<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo1.controllers.AddZoneController" spacing="10" alignment="CENTER">
    <Label text="Add New Zone" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Label text="Location:"/>
    <TextField fx:id="locationField" promptText="Enter Zone Location"/>
    <Button text="Add Zone" onAction="#handleAddZone" style="-fx-font-size: 14;"/>
</VBox>
