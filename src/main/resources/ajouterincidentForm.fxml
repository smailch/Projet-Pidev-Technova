         <font>
            <Font name="Britannic Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="469.0" layoutY="233.0" prefHeight="20.0" prefWidth="197.0" text="Utiliser le bar de recherche " textFill="#ff0c0c">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
</children>
