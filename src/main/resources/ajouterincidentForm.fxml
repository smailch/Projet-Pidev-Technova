<AnchorPane prefHeight="644.0" prefWidth="944.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.IncidentController">
<!-- Correct placement of the stylesheets -->
<stylesheets>
    <URL value="@assets/css/styles.css" />
    <URL value="file:/C:/demo/src/main/resources/assets/css/box.css" />

</stylesheets>

<children>
    <fx:include source="sidebar.fxml" />

    <ComboBox fx:id="typeIncidentComboBox" layoutX="451.0" layoutY="91.0" prefHeight="34.0" prefWidth="230.0" promptText="Sélectionner un type d'incident" />
    <TextField fx:id="descriptionField" layoutX="451.0" layoutY="142.0" onKeyPressed="#onEnterPressed" prefHeight="26.0" prefWidth="230.0" />

    <!-- WebView pour la carte (affichage de la carte) -->
    <WebView fx:id="mapView" layoutX="377.0" layoutY="475.0" prefHeight="120.0" prefWidth="390.0" />

    <!-- Bouton pour choisir l'adresse via la carte -->
    <Button fx:id="confirmAddressButton" layoutX="810.0" layoutY="507.0" mnemonicParsing="false" onMouseClicked="#fetchAndSetAddress" prefHeight="34.0" prefWidth="129.0" style="-fx-background-color: #39df09; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="Confirmer l'adresse" visible="false" />
    <Button fx:id="btnNavigateToList" layoutX="725.0" layoutY="97.0" mnemonicParsing="false" onAction="#goTolisterIncidentPage" prefHeight="34.0" prefWidth="185.0" style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="consulter la liste des incidents -&gt;" />

    <Text fx:id="affichemapText" fill="#4400ff" layoutX="324.0" layoutY="402.0" onMouseClicked="#showMap" text="Déplacez le marqueur sur la carte pour définir votre emplacement" wrappingWidth="484.6019287109375">
        <font>
            <Font size="16.0" />
        </font></Text>
    <!-- WebView pour l'autocomplétion d'adresse -->
    <WebView fx:id="autocompleteView" layoutX="451.0" layoutY="266.0" prefHeight="100.0" prefWidth="230.0" />

    <!-- Champ Localisation (lecture seule, mis à jour dynamiquement par le contrôleur) -->
    <Label fx:id="localisationLabel" layoutX="457.0" layoutY="601.0" prefHeight="26.0" prefWidth="230.0" text="" />
    <Button fx:id="chooseImageButton" layoutX="451.0" layoutY="184.0" onAction="#choisirImage" prefHeight="26.0" prefWidth="230.0" text="Choisir une image" />
    <ImageView fx:id="imageView" fitHeight="100.0" fitWidth="174.0" layoutX="730.0" layoutY="153.0" />

    <!-- Table pour afficher les incidents -->


    <!-- Fond coloré en bas -->
    <AnchorPane layoutX="249.0" prefHeight="76.0" prefWidth="699.0" style="-fx-background-color: #6200ea;">
        <children>
            <Label layoutX="248.0" layoutY="14.0" text="Ajouter un incident" textFill="WHITE">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
        </children></AnchorPane>
    <Button fx:id="btnSignin" layoutX="503.0" layoutY="428.0" mnemonicParsing="false" onMouseClicked="#ajouterIncident" prefHeight="34.0" prefWidth="137.0" style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="Ajouter Incident" />
      <Label layoutX="469.0" layoutY="230.0" textFill="#4400ff">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
