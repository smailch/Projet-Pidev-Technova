      </Label>
      <Label layoutX="351.0" layoutY="147.0" text="Description :">
         <font>
            <Font name="Britannic Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="351.0" layoutY="308.0" text="Localisation:">
         <font>
            <Font name="Britannic Bold" size="14.0" />
         </font>
