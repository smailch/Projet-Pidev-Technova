<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="638.0" prefWidth="943.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HistoriqueCitoyenController">
    <fx:include source="sidebar.fxml" />

    <!-- Table d'affichage des services -->
    <TableView fx:id="tableIncidentsResolus" layoutX="258.0" layoutY="323.0" prefHeight="166.0" prefWidth="683.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="58.4000244140625" text="ID" />
            <TableColumn fx:id="colType" prefWidth="92.800048828125" text="Type" />
            <TableColumn fx:id="colDescription" prefWidth="116.0" text="Description" />
            <TableColumn fx:id="colLocalisation" prefWidth="104.79998779296875" text="Localisation" />
            <TableColumn fx:id="colDateSignalement" prefWidth="139.199951171875" text="Date Signalement" />
            <TableColumn fx:id="colDateResolution" prefWidth="165.5999755859375" text="Durée de Résolution" />
        </columns>
    </TableView>

    <AnchorPane layoutX="250.0" prefHeight="76.0" prefWidth="700.0" style="-fx-background-color: #6200ea;">
        <children>
            <Label layoutX="176.0" layoutY="20.0" text="Historique des incidents résolus" textFill="WHITE">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
        </children>
    </AnchorPane>

    <Button fx:id="btnNavigateToList" layoutX="284.0" layoutY="109.0" mnemonicParsing="false" onAction="#goTolisterIncidentPage" prefHeight="34.0" prefWidth="111.0" style="-fx-background-color: #6200ea; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="&lt;- retour" />
    <Button fx:id="btnSignin111" layoutX="284.0" layoutY="603.0" mnemonicParsing="false" onMouseClicked="#supprimerIncident" prefHeight="34.0" prefWidth="134.0" style="-fx-background-color: #ff0000; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="Supprimer Incident" />
   <Label layoutX="302.0" layoutY="182.0" text="Bienvenue sur cette page dédiée à l'historique des incidents résolus.">
      <font>
         <Font size="17.0" />
      </font>
   </Label>
   <Label layoutX="343.0" layoutY="209.0" text="Ici, vous pouvez consulter les détails de chaque incident,">
      <font>
         <Font size="17.0" />
      </font>
   </Label>
   <Label layoutX="267.0" layoutY="235.0" text="nous mettons tout en œuvre pour résoudre chaque signalement dans les meilleurs délais">
      <font>
         <Font size="17.0" />
      </font>
   </Label>
   <Label layoutX="267.0" layoutY="261.0" prefHeight="26.0" prefWidth="666.0" text="et ainsi améliorer votre quotidien. Merci de votre patience et de votre compréhension.">
      <font>
         <Font size="17.0" />
      </font>
   </Label>
</AnchorPane>
