<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.controllers.AddLampadaireController"
           styleClass="main-container">

    <VBox spacing="20" alignment="CENTER" styleClass="content-container">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>



        <!-- Form Container -->
        <VBox spacing="15" styleClass="form-container">
            <!-- Localisation Field -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Location" styleClass="field-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="localisationField" promptText="Click on the map to select location"
                               editable="false" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                    <Button text="Open Map" onAction="#openMapWindow" styleClass="map-button"/>
                </HBox>
            </VBox>

            <!-- Etat Field -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Status" styleClass="field-label"/>
                <CheckBox fx:id="etatField" text="Active" styleClass="status-checkbox"/>
            </VBox>

            <!-- Consommation Field -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Power Consumption (W)" styleClass="field-label"/>
                <TextField fx:id="consommationField" promptText="Enter power consumption" styleClass="text-field"/>
            </VBox>

            <!-- Quartier ID Field -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="District" styleClass="field-label"/>
                <ComboBox fx:id="quartierComboBox" promptText="Select district" styleClass="combo-box"/>
            </VBox>

            <!-- Date Installation Field -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Installation Date" styleClass="field-label"/>
                <DatePicker fx:id="dateInstallationField" styleClass="date-picker"/>
            </VBox>
        </VBox>

        <!-- Action Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Save" onAction="#handleSave" styleClass="save-button"/>
            <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        </HBox>
    </VBox>
</StackPane>