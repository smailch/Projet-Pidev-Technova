<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controllers.MapWindowController"
      stylesheets="@styles.css"
      spacing="10"
      prefHeight="500"
      prefWidth="800">

    <WebView fx:id="mapView" styleClass="map-container" />
    <Button fx:id="saveButton" styleClass="save-button" text="Save Location" onAction="#handleSave" />

</VBox>