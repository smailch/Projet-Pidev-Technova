<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.controllers.AddQuartierController"
           styleClass="root">

    <VBox spacing="20" alignment="CENTER">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- Titre -->
        <HBox alignment="CENTER" spacing="15">
            <HBox HBox.hgrow="ALWAYS">
                <Label text="Ajouter un Nouveau Quartier" styleClass="title-label"/>
            </HBox>
            <ToggleButton text="Mode Sombre" fx:id="themeToggle" onAction="#toggleTheme" styleClass="button-light"/>
        </HBox>

        <!-- Conteneur du Formulaire -->
        <VBox spacing="15" styleClass="container">
            <!-- Champ Nom -->
            <VBox spacing="5">
                <Label text="Nom" styleClass="sub-title"/>
                <TextField fx:id="nomField" promptText="Entrez le nom du quartier"/>
            </VBox>

            <!-- Champ Nombre de Lampadaires -->
            <VBox spacing="5">
                <Label text="Nombre de Lampadaires" styleClass="sub-title"/>
                <TextField fx:id="nbLampField" promptText="Entrez le nombre de lampadaires"/>
            </VBox>

            <!-- Champ Consommation Totale -->
            <VBox spacing="5">
                <Label text="Consommation Totale (W)" styleClass="sub-title"/>
                <TextField fx:id="consomTotField" promptText="Entrez la consommation totale d'énergie"/>
            </VBox>
        </VBox>

        <!-- Section des Boutons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Enregistrer le Quartier" onAction="#handleAddQuartier" styleClass="button"/>
            <Button text="Retour au Menu" onAction="#goToMenu" styleClass="button-light"/>
        </HBox>
    </VBox>
</StackPane>