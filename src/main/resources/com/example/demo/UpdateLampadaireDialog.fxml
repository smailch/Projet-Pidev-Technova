<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ToggleButton?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.controllers.UpdateLampadaireDialogController"
           styleClass="main-container">

    <VBox spacing="20" alignment="CENTER" styleClass="content-container">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- Titre -->
        <Label text="Mettre à jour le lampadaire" styleClass="title-label"/>

        <!-- Conteneur du formulaire -->
        <VBox spacing="15" styleClass="form-container">
            <!-- Champ de localisation -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Localisation" styleClass="field-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="localisationField" promptText="Localisation (lecture seule)"
                               editable="false" disable="true" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Champ État -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="État" styleClass="field-label"/>
                <CheckBox fx:id="etatField" text="Actif" styleClass="status-checkbox"/>
            </VBox>

            <!-- Champ Consommation -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Consommation électrique (W)" styleClass="field-label"/>
                <TextField fx:id="consommationField" promptText="Entrez la consommation électrique" styleClass="text-field"/>
            </VBox>

            <!-- Champ Quartier -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Quartier" styleClass="field-label"/>
                <ComboBox fx:id="quartierComboBox" promptText="Sélectionnez un quartier" styleClass="combo-box"/>
            </VBox>

            <!-- Champ Date d'installation -->
            <VBox spacing="5" styleClass="field-container">
                <Label text="Date d'installation" styleClass="field-label"/>
                <DatePicker fx:id="dateInstallationField" styleClass="date-picker"/>
            </VBox>
        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Enregistrer" onAction="#handleSave" styleClass="button"/>
            <Button text="Annuler" onAction="#handleCancel" styleClass="button-danger"/>
            <ToggleButton fx:id="darkModeToggle" text="Mode sombre" styleClass="dark-mode-toggle"/>
        </HBox>

    </VBox>
</StackPane>
