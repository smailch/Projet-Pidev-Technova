<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.sothawo.mapjfx.MapView?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.QuartierMapViewController"
            prefHeight="600" prefWidth="800">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="5" left="10"/>
            </padding>
            <Label fx:id="quartierNameLabel" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label fx:id="lampadairesInfoLabel" style="-fx-font-size: 14;"/>
        </VBox>
    </top>

    <center>
        <MapView fx:id="mapView"/>
    </center>

    <right>
        <ScrollPane fitToWidth="true" prefWidth="200">
            <VBox fx:id="markerDetailsContainer" spacing="5">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </VBox>
        </ScrollPane>
    </right>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="5" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Close" onAction="#handleClose" style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>